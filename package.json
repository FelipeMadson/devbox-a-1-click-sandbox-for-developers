{
  "name": "devbox-a-1-click-sandbox-for-developers",
  "version": "1.1.0",
  "description": "Painful and time-consuming setup guides for development environments. DevBox is an automated local sandbox.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "devbox-a-1-click-sandbox-for-developers": "src/cli/cli.ts"
